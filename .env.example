# ── douyin-chat-export 环境变量配置 ──────────────────────────
# 这是示例文件，不含任何真实密钥。
# 复制为 .env 并填入你自己的值。

# ── 运行环境 ─────────────────────────────────────────────────
# production | development
# production 要求设置密码、密钥和 Cookie 安全选项
APP_ENV=development

# ── 应用密钥 ─────────────────────────────────────────────────
# 用于签名 CSRF Token、Session Token HMAC、匿名导出等
# 生产环境必须设置为 32 字符以上随机字符串
# 可通过 Docker Secret 注入: APP_SECRET_KEY_FILE=/run/secrets/dce_app_key
APP_SECRET_KEY=
APP_SECRET_KEY_FILE=

# ── 密码策略 ─────────────────────────────────────────────────
# 生产环境绝对不要设置为 true
ALLOW_INSECURE_NO_PASSWORD=false

# ── Cookie 安全 ──────────────────────────────────────────────
# 生产环境必须为 true（要求 HTTPS 或反向代理配置）
COOKIE_SECURE=false

# ── Session 超时 ─────────────────────────────────────────────
SESSION_IDLE_TTL_SECONDS=1800     # 空闲 30 分钟过期
SESSION_ABSOLUTE_TTL_SECONDS=86400 # 最多 24 小时
SESSION_REMEMBER_TTL_SECONDS=604800 # "记住我" 7 天

# ── 网络限制 ─────────────────────────────────────────────────
# 可信代理 CIDR（用于正确解析 X-Forwarded-For）
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# 管理接口允许的网络（默认仅本机）
ADMIN_ALLOWED_CIDRS=127.0.0.1/32,::1/128

# ── 功能开关（生产默认关闭）────────────────────────────────
# 远程扫码登录
ENABLE_REMOTE_LOGIN=false
# Cookie 导入
ENABLE_COOKIE_IMPORT=false
# 外部媒体（头像等）
ENABLE_EXTERNAL_MEDIA=false
# Server酱 通知
ENABLE_SERVERCHAN=false

# ── 导出安全 ─────────────────────────────────────────────────
# 导出文件有效期（秒），默认 15 分钟
EXPORT_TTL_SECONDS=900
# 一次性下载后删除
EXPORT_ONE_TIME_DOWNLOAD=true

# ── 日志 ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_REDACTION=true

# ── 外部媒体策略 ─────────────────────────────────────────────
# block | proxy | direct
EXTERNAL_MEDIA_POLICY=block

# ── 数据保留 ─────────────────────────────────────────────────
# compatibility | standard | minimal
DATA_RETENTION_MODE=compatibility
STORE_RAW_DATA=true
